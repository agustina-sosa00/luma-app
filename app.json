{
  "expo": {
    "name": "Luma app",
    "slug": "Luma app",
    "version": "1.0.0",
    "web": {
      "favicon": "./assets/logoLuma.png",
      "bundler": "metro"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": ["expo-font"],
    "orientation": "portrait",
    "icon": "./assets/logoLuma.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logoLuma.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logoLuma.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.anonymous.Lumaapp",
      "permissions": ["ACCESS_FINE_LOCATION"]
    },
    "config": {
      "googleMaps": {
        "apiKey": "TU_API_KEY"
      }
    }
  }
}
